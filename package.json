{
  "name": "odero-victor-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, production-ready portfolio website built with React 18, Vite, and CSS3",
  "author": "Victor Odero",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "analyze": "npm run build && echo 'Build complete'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.1.1",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": "16.x || 18.x || 20.x",
    "npm": "8.x || 9.x || 10.x"
  },
  "keywords": [
    "portfolio",
    "react",
    "vite",
    "frontend",
    "developer",
    "ui-designer",
    "web-development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/otienovictor717-svg/odero-victor-portfolio.git"
